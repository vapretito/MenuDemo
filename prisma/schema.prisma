generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  RESTAURANT_ADMIN
}

enum RestaurantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  MANUAL
}

enum DnsStatus {
  PENDING
  CONFIGURED
  ERROR
}

enum BillingMode {
  MERCADO_PAGO_SUBSCRIPTION
  MANUAL
}

enum SubscriptionStatus {
  SCHEDULED
  PENDING
  AUTHORIZED
  ACTIVE
  PAUSED
  CANCELLED
  PAST_DUE
  ENDED
}

enum CollectionMethod {
  AUTOMATIC
  MANUAL
}

enum PaymentStatus {
  PENDING
  APPROVED
  AUTHORIZED
  IN_PROCESS
  REJECTED
  CANCELLED
  REFUNDED
  CHARGED_BACK
}

enum WebhookProcessStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum RestaurantOrderingExperience {
  DELIVERY
  LOCAL_QR
}

enum RestaurantFulfillmentMode {
  DELIVERY_ONLY
  TAKEAWAY_ONLY
  DELIVERY_AND_TAKEAWAY
}

enum ServiceMode {
  TABLE_SERVICE
  COUNTER_PICKUP
  BOTH
}

enum LocalPaymentTiming {
  PAY_BEFORE_PREPARATION
  PAY_LATER
}

enum LocalOrderSource {
  WHATSAPP
  LOCAL_QR
}

enum LocalOrderStatus {
  AWAITING_PAYMENT
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  EXPIRED
  CANCELLED
}

enum LocalPaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum GuestSessionEntryPoint {
  GENERAL_QR
  LOCATION_QR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         UserRole @default(RESTAURANT_ADMIN)

  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([restaurantId])
}

model Restaurant {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  subdomain String @unique

  city        String
  cuisine     String
  description String

  address              String?
  googleMapsUrl        String?
  instagramUrl         String?
  deliveryZones        String?
  deliveryTimeEstimate String?

  status      RestaurantStatus @default(TRIAL)
  dnsStatus   DnsStatus        @default(PENDING)
  billingMode BillingMode      @default(MERCADO_PAGO_SUBSCRIPTION)

  connectedToDemo Boolean @default(false)

  adminName        String?
  adminWhatsapp    String?
  customerWhatsapp String
  onboardingNote   String?
  graceUntil       DateTime?
  trialEndsAt DateTime?

  menuTemplate  String  @default("classic-delivery")
  logoUrl       String?
  logoSize      String  @default("medium")
  logoPosition  String  @default("left")
  coverImageUrl String?
  qrShowMenuiBranding Boolean @default(true)
  defaultOrderingExperience RestaurantOrderingExperience @default(DELIVERY)
  fulfillmentMode          RestaurantFulfillmentMode      @default(DELIVERY_ONLY)
  localOrderingEnabled      Boolean                       @default(false)
  serviceMode               ServiceMode                   @default(COUNTER_PICKUP)
  localPaymentTiming        LocalPaymentTiming            @default(PAY_BEFORE_PREPARATION)
  unpaidOrderExpirationMinutes Int                        @default(15)
  localOrderDeletionCodeHash String?

  accent       String @default("#f0c400")
  accentSoft   String @default("#fff1ac")
  surface      String @default("#fffdf7")
  surfaceAlt   String @default("#f4f2e8")
  border       String @default("#1f4723")
  text         String @default("#162218")
  titleColor   String @default("#ffffff")
  muted        String @default("#58705c")
  heroGradient String @default("linear-gradient(180deg, #2f7f3a 0%, #1f4723 100%)")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  subscription  Subscription?
  categories    Category[]
  products      Product[]
  payments      Payment[]
  webhookEvents WebhookEvent[]

  whatsappIntroMessage  String @default("Hola, quiero hacer este pedido desde el menú online:")
  whatsappFooterMessage String @default("Por favor confirmar disponibilidad y tiempo estimado.")

  cartEvents CartEvent[]
  customers  Customer[]

  isAcceptingOrders Boolean @default(true)
  closedMessage     String  @default("Estamos cerrados por ahora. Podés revisar el menú y consultarnos por WhatsApp.")

  openingHours     Json?
  openingHoursNote String @default("Horarios sujetos a disponibilidad del restaurante.")
  showOpeningHours Boolean @default(true)
  timeZone String @default("America/Argentina/Cordoba")

  cashClosures CashClosure[]
  localCashClosures LocalCashClosure[]
  feedbackEntries Feedback[]
  serviceLocations ServiceLocation[]
  guestSessions GuestSession[]
  localOrders Order[]

  @@index([status])
  @@index([dnsStatus])
  @@index([billingMode])
}

model Feedback {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  message String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([createdAt])
}

model CartEvent {
  id               String   @id @default(cuid())
  restaurantId     String
  restaurantSlug   String
  customerId       String?
  customerName     String
  customerWhatsapp String
  marketingConsent Boolean  @default(false)
  source           String   @default("menu")
  totalArs         Int
  itemCount        Int
  paymentMethod    String
  deliveryAddress  String?
  customerNote     String?
  itemsSnapshot    Json
  createdAt        DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([restaurantSlug])
  @@index([customerId])
  @@index([customerWhatsapp])
  @@index([createdAt])
}

model Customer {
  id                 String   @id @default(cuid())
  restaurantId       String
  name               String
  whatsapp           String
  marketingConsent   Boolean  @default(false)
  marketingConsentAt DateTime?
  source             String   @default("menu")
  firstOrderAt       DateTime @default(now())
  lastOrderAt        DateTime @default(now())
  lastOrderTotalArs  Int      @default(0)
  orderCount         Int      @default(0)
  totalSpentArs      Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cartEvents  CartEvent[]

  @@unique([restaurantId, whatsapp])
  @@index([restaurantId])
  @@index([lastOrderAt])
  @@index([orderCount])
  @@index([createdAt])
}

model CashClosure {
  id                String   @id @default(cuid())
  restaurantId      String
  businessDate      String
  timeZone          String
  totalEvents       Int      @default(0)
  totalEstimatedArs Int      @default(0)
  totalItems        Int      @default(0)
  averageTicketArs  Int      @default(0)
  paymentBreakdown  Json
  notes             String?
  createdAt         DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, businessDate])
  @@index([restaurantId])
  @@index([businessDate])
  @@index([createdAt])
}

model LocalCashClosure {
  id            String   @id @default(cuid())
  restaurantId  String
  businessDate  String
  timeZone      String
  totalOrders   Int      @default(0)
  totalPaidArs  Int      @default(0)
  totalItems    Int      @default(0)
  averageTicketArs Int   @default(0)
  statusBreakdown Json
  notes         String?
  createdAt     DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, businessDate])
  @@index([restaurantId])
  @@index([businessDate])
  @@index([createdAt])
}

model ServiceLocation {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name       String
  publicToken String @unique
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guestSessions GuestSession[]
  orders        Order[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([restaurantId, isActive])
}

model GuestSession {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  serviceLocationId String?
  serviceLocation   ServiceLocation? @relation(fields: [serviceLocationId], references: [id], onDelete: SetNull)

  entryPoint  GuestSessionEntryPoint
  sessionToken String @unique
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([serviceLocationId])
  @@index([entryPoint])
  @@index([expiresAt])
}

model Order {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  source      LocalOrderSource  @default(LOCAL_QR)
  serviceMode ServiceMode

  serviceLocationId String?
  serviceLocation   ServiceLocation? @relation(fields: [serviceLocationId], references: [id], onDelete: SetNull)

  customerName  String?
  pickupCode    String?
  status        LocalOrderStatus   @default(AWAITING_PAYMENT)
  paymentStatus LocalPaymentStatus @default(PENDING)
  totalArs      Int
  customerNote  String?

  confirmedAt DateTime?
  paidAt      DateTime?
  expiresAt   DateTime?
  deletedAt   DateTime?
  deletedByAdmin Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items OrderItem[]

  @@unique([restaurantId, pickupCode])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, paymentStatus])
  @@index([serviceLocationId])
  @@index([createdAt])
  @@index([paidAt])
  @@index([expiresAt])
  @@index([deletedAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId     String?
  productName   String
  unitPriceArs  Int
  quantity      Int
  notes         String?
  subtotalArs   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name        String
  description String
  hidden      Boolean @default(false)
  sortOrder   Int    @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

model Product {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name        String
  description String
  priceArs    Int
  image       String?
  featured    Boolean @default(false)
  available   Boolean @default(true)
  prepTime    String  @default("15 min")
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([categoryId])
  @@index([available])
  @@index([featured])
}

model Subscription {
  id           String     @id @default(cuid())
  restaurantId String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  planId    String
  planName  String
  amountArs Int
  cycle     String @default("monthly")

  collectionMethod CollectionMethod   @default(AUTOMATIC)
  status           SubscriptionStatus @default(SCHEDULED)

  mercadopagoPreapprovalId String? @unique
  mercadopagoPayerEmail    String?
  mercadopagoInitPoint     String?

  renewsOn      DateTime?
  lastPaymentAt DateTime?
  nextPaymentAt DateTime?
  cancelledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
  payerEmail String?

  @@index([status])
  @@index([planId])
}

model Payment {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  amountArs Int
  currency  String        @default("ARS")
  status    PaymentStatus @default(PENDING)

  mercadopagoPaymentId     String? @unique
  mercadopagoPreapprovalId String?
  mercadopagoRawStatus     String?
  mercadopagoStatusDetail  String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([subscriptionId])
  @@index([status])
  @@index([mercadopagoPreapprovalId])
}

model WebhookEvent {
  id           String      @id @default(cuid())
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  provider String @default("mercadopago")

  eventType  String
  action     String?
  resourceId String?

  requestId          String?
  signatureValidated Boolean @default(false)

  processStatus WebhookProcessStatus @default(RECEIVED)
  errorMessage  String?

  payload Json

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([restaurantId])
  @@index([provider])
  @@index([eventType])
  @@index([resourceId])
  @@index([processStatus])
}
